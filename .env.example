# Imprint — environment configuration
#
# Copy this file to .env.local and fill in the values you need:
#
#   cp .env.example .env.local
#
# .env.local is git-ignored; never commit real secrets.

# --------------------------------------------------------------------------
# IMPRINT_TOKEN (required)
# --------------------------------------------------------------------------
# Bearer token that protects every write path and every read of a draft.
# Required by src/lib/auth.ts — without it, all authenticated routes return
# 401 (see `guard()`). Pick any non-empty string for local development.
#
# Send it as either:
#   Authorization: Bearer <token>
# or
#   ?token=<token>
IMPRINT_TOKEN=dev-secret-change-me

# --------------------------------------------------------------------------
# IMPRINT_SQLITE_PATH (optional)
# --------------------------------------------------------------------------
# Path to the SQLite database file used by the store (packages/store) and
# every CLI command (seed, gates, doctor, migrate).
# Defaults to ./data/imprint.db if unset.
# IMPRINT_SQLITE_PATH=./data/imprint.db

# --------------------------------------------------------------------------
# IMPRINT_DRIVER (optional)
# --------------------------------------------------------------------------
# Which store driver to use. Currently only "sqlite" is implemented, even
# though the committed migrations target Postgres DDL.
# Defaults to "sqlite" if unset.
# IMPRINT_DRIVER=sqlite

# --------------------------------------------------------------------------
# IMPRINT_STUDIO_ORIGIN (optional)
# --------------------------------------------------------------------------
# Origin the rendered site links back to for its "edit in studio" affordance.
# Defaults to http://localhost:3100 if unset — only change this if you run
# the studio on a different host/port than the site.
# IMPRINT_STUDIO_ORIGIN=http://localhost:3100
