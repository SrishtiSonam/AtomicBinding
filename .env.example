
# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local before running the application:
#   cp .env.example .env.local
# ==============================================================================

# Authentication token for API write operations and draft previews
IMPRINT_TOKEN=dev-secret-token-change-me

# Storage configuration
IMPRINT_DRIVER=sqlite
IMPRINT_SQLITE_PATH=./data/imprint.db

# Studio and preview settings
IMPRINT_STUDIO_ORIGIN=http://localhost:3100
